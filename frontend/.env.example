VITE_API_BASE_URL=http://localhost:8000

# Demo admin login. Leave both empty to use the built-in PUBLIC demo account
# (see README.md), which is pre-filled on the Admin Login page for evaluators.
# Note: every VITE_* value is compiled into the public JS bundle — never put a
# real/private password here.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# Real SIM number inside the Android SMS Gateway phone (NOT the LAN IP 172.x)
VITE_SMS_GATEWAY_NUMBER=+91XXXXXXXXXX
